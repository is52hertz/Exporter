{
  "sourceLanguage" : "en",
  "strings" : {
    "NSLocalNetworkUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used to send your data to the backup address on your local network that you entered in Settings. Exporter does not look for or connect to any other device."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于把数据发送到你在设置里填写的局域网备用地址。Exporter 不会查找或连接其他设备。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
